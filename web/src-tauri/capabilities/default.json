{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for Personal Vault windows (main + quick access). No shell/fs access.",
  "windows": [
    "main",
    "quick"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
