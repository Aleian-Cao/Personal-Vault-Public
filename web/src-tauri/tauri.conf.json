{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PersonalVault",
  "version": "0.1.0",
  "identifier": "com.aleian.personalvault",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Personal Vault",
        "width": 1040,
        "height": 720,
        "minWidth": 780,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,StorageServiceOutOfProcess --disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync --no-pings --disable-breakpad --disable-gpu --renderer-process-limit=1 --enable-features=NetworkServiceInProcess2 --no-proxy-server"
      },
      {
        "label": "quick",
        "title": "Personal Vault - Quick Access",
        "url": "index.html#quick",
        "width": 560,
        "height": 440,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,StorageServiceOutOfProcess --disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync --no-pings --disable-breakpad --disable-gpu --renderer-process-limit=1 --enable-features=NetworkServiceInProcess2 --no-proxy-server"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "bin/pvault-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}